{
  "name": "moirae",
  "version": "0.1.0",
  "description": "Deterministic simulation testing for distributed systems, with a visual trace replay. `moirae demo` runs a 5-node Raft cluster through a partition and shows you the failure.",
  "license": "Apache-2.0",
  "author": "Prodromos Chrysostomou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pchrysostomou/moirae.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pchrysostomou/moirae#readme",
  "bugs": "https://github.com/pchrysostomou/moirae/issues",
  "keywords": [
    "deterministic-simulation",
    "distributed-systems",
    "raft",
    "testing",
    "simulation",
    "trace",
    "replay"
  ],
  "type": "module",
  "bin": {
    "moirae": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "moirae-core": "workspace:*",
    "@moirae/examples": "workspace:*",
    "moirae-protocols": "workspace:*",
    "@moirae/studio": "workspace:*",
    "vite": "^8.2.2"
  }
}
