{
  "name": "@nemea/protocols",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nemea/core": "workspace:^"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "description": "Raft for the nemea simulator, transcribed from the paper, with its safety invariants.",
  "license": "Apache-2.0",
  "author": "Prodromos Chrysostomou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pchrysostomou/nemea.git",
    "directory": "packages/protocols"
  },
  "homepage": "https://github.com/pchrysostomou/nemea#readme",
  "keywords": [
    "deterministic-simulation",
    "distributed-systems",
    "testing",
    "simulation",
    "raft"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
